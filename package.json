{
  "name": "agentvault-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "postinstall": "node packages/tokens/build.mjs",
    "tokens": "node packages/tokens/build.mjs",
    "dev": "pnpm tokens && pnpm --filter @agentvault/console dev",
    "dev:site": "pnpm tokens && pnpm --filter @agentvault/site dev",
    "build": "pnpm --filter @agentvault/console build && pnpm --filter @agentvault/site build",
    "check-classes": "node scripts/check-classes.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "budgets": "node scripts/budgets.mjs",
    "storybook": "pnpm tokens && pnpm --filter @agentvault/ui storybook",
    "build-storybook": "pnpm --filter @agentvault/ui build-storybook",
    "test:e2e": "pnpm build && pnpm build-storybook && playwright test -c e2e/playwright.config.ts",
    "verify": "pnpm tokens && pnpm check-classes && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check-routes && pnpm budgets",
    "format": "prettier --write .",
    "check-routes": "node scripts/check-routes.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
