---
import { Code, Database, MonitorSmartphone, UserRound } from "lucide-react";
import { copy } from "../content/en";
import Arrow from "../components/Arrow.astro";
import Container from "../components/Container.astro";
import MotionToggle from "../components/MotionToggle.astro";
import SiteSeal from "../components/SiteSeal.astro";
import { SealGlyph } from "../lib/ui";

const p = copy.platform;
const callerIcons = [MonitorSmartphone, Code, UserRound];
const targetHashes = [
  "sha256:9f2c41d0b7a3e5c8f1d24a6b90e7c3f5d81e2a4c6b8d0f1e3a5c7e9b2d4fe81a",
  "sha256:3b7e0c9a4f12d6e8b5a1c3f7e9d2b4a6c8e0f1d3b5a7c9e2f4d6b8a0c1e3d5f7",
  "sha256:0a7d52c9e81f3b6a4d0c2e5f7a9b1c3d5e7f9a1b3c5d7e9f0a2b4c6d8e0f2a4b",
];
const card = "flex items-center gap-3 rounded-panel border border-edge bg-raised p-4";
---

<section id="platform" aria-labelledby="platform-title" data-theme="dark" class="bg-surface text-ink" data-loop data-platform>
  <Container class="py-(--site-section-y)">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 id="platform-title" class="m-0 max-w-(--site-measure-h2-narrow) text-site-h2">{p.title}</h2>
      <MotionToggle />
    </div>

    <div class="mt-12 flex flex-col items-stretch gap-5 lg:flex-row">
      <div class="flex min-w-0 flex-1 flex-col gap-3">
        <h3 class="m-0 text-body font-normal text-ink-muted">{p.whoCalls}</h3>
        <ul class="m-0 flex list-none flex-col gap-3 p-0">
          {
            p.callers.map((label, i) => {
              const Icon = callerIcons[i]!;
              const own = i === 2;
              return (
                <li data-caller class={own ? `${card} border-seal-intact bg-status-success-bg` : card}>
                  <Icon aria-hidden="true" className={own ? "size-7 text-link" : "size-7 text-ink-secondary"} strokeWidth={1.6} />
                  <span class="font-semibold">{label}</span>
                </li>
              );
            })
          }
        </ul>
      </div>

      <Arrow stackBelow="lg" tone="intact" />

      <div class="flex min-w-0 flex-wide flex-col items-center gap-4 rounded-overlay border-2 border-seal-intact bg-canvas p-6">
        <SiteSeal hash="sha256:c4e19b7a2f05d83e6a1b9c7d5e3f1a0b2c4d6e8f0a1b3c5d7e9f2a4b6c8d0e1f" state="intact" sizeClass="size-(--site-diagram-seal)" />
        <div class="text-title-2">{p.product}</div>
        <ol class="m-0 grid w-full list-none grid-cols-2 gap-2 p-0 text-center text-body sm:grid-cols-3">
          {
            p.checks.map((check, i) => (
              <li
                data-check
                style={`--i: ${i}`}
                class={
                  i === 2
                    ? "rounded-control border border-seal-intact px-2 py-2 font-semibold text-link"
                    : i === 4
                      ? "rounded-control border border-strip-person-bg px-2 py-2 text-risk-medium-fg"
                      : "rounded-control border border-edge px-2 py-2"
                }
              >
                {check}
              </li>
            ))
          }
        </ol>
        <ul class="m-0 flex list-none flex-wrap justify-center gap-2 p-0 text-body">
          <li class="rounded-pill bg-status-success-bg px-3 py-1 text-link">{p.gateways[0]}</li>
          <li class="rounded-pill bg-status-info-bg px-3 py-1 text-status-info-fg">{p.gateways[1]}</li>
          <li class="rounded-pill bg-raised px-3 py-1 text-ink-secondary">{p.gateways[2]}</li>
        </ul>
      </div>

      <Arrow stackBelow="lg" tone="intact" />

      <div class="flex min-w-0 flex-1 flex-col gap-3">
        <h3 class="m-0 text-body font-normal text-ink-muted">{p.whatTheyReach}</h3>
        <ul class="m-0 flex list-none flex-col gap-3 p-0">
          {
            p.targets.map((label, i) => (
              <li data-target class={card}>
                {targetHashes[i] ? (
                  <SealGlyph hash={targetHashes[i]} state="intact" size="sm" label={label} decorative />
                ) : (
                  <Database aria-hidden="true" className="size-6 text-ink-secondary" strokeWidth={1.6} />
                )}
                <span class="font-semibold">{label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-x-8 gap-y-2 rounded-panel border border-dashed border-edge-strong px-6 py-4 text-site-small text-ink-secondary">
      <span class="font-semibold text-ink">{p.governance}</span>
      {p.governanceItems.map((item) => <span>{item}</span>)}
    </div>
  </Container>
</section>
