---
import { copy } from "../content/en";
import Container from "../components/Container.astro";

const d = copy.deploy;
const S = "var(--av-seal-intact)";
const F = "var(--av-seal-core-intact)";
const N = "var(--av-text-secondary)";
const M = "var(--av-text-muted)";
---

<section id="deploy" aria-labelledby="deploy-title" class="bg-canvas">
  <Container class="py-(--site-section-y)">
    <h2 id="deploy-title" class="m-0 text-site-h2 text-ink">{d.title}</h2>
    <ul class="m-0 mt-12 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {
        d.options.map((o, i) => {
          const later = o.stage === "Later";
          return (
            <li data-reveal style={`--i: ${i * 2}`} class={later ? "rounded-overlay border border-dashed border-edge-strong bg-sunken p-6" : "rounded-overlay border border-edge bg-surface p-6"}>
              <svg width="120" height="72" viewBox="0 0 120 72" aria-hidden="true">
                {o.key === "saas" && (
                  <>
                    <path d="M30 56h62a16 16 0 0 0 0-32 24 24 0 0 0-46-4 18 18 0 0 0-16 36z" fill={F} stroke={S} stroke-width="2" />
                    <circle cx="60" cy="40" r="10" fill="none" stroke={S} stroke-width="3" stroke-dasharray="4 2" />
                  </>
                )}
                {o.key === "tenant" && (
                  <>
                    <path d="M30 56h62a16 16 0 0 0 0-32 24 24 0 0 0-46-4 18 18 0 0 0-16 36z" fill={F} stroke={S} stroke-width="2" />
                    <rect x="48" y="30" width="24" height="20" rx="2" fill="var(--av-bg-surface)" stroke={S} stroke-width="2" />
                    <path d="M53 30v-5a7 7 0 0 1 14 0v5" fill="none" stroke={S} stroke-width="2" />
                  </>
                )}
                {o.key === "hybrid" && (
                  <>
                    <path d="M10 40h36a10 10 0 0 0 0-20 15 15 0 0 0-28-2 11 11 0 0 0-8 22z" fill={F} stroke={S} stroke-width="2" />
                    <rect x="78" y="22" width="34" height="40" fill="var(--av-bg-sunken)" stroke={N} stroke-width="2" />
                    <path d="M84 30h6M96 30h6M84 40h6M96 40h6" stroke={N} stroke-width="2" />
                    <path d="M50 32h26" stroke={S} stroke-width="2" stroke-dasharray="4 3" />
                    <circle cx="95" cy="54" r="5" fill={S} />
                  </>
                )}
                {o.key === "airgap" && (
                  <>
                    <rect x="38" y="10" width="44" height="54" fill="var(--av-bg-surface)" stroke={M} stroke-width="2" />
                    <path d="M46 20h8M66 20h8M46 32h8M66 32h8M46 44h8M66 44h8" stroke={M} stroke-width="2" />
                    <path d="M20 64h80" stroke={M} stroke-width="2" />
                  </>
                )}
              </svg>
              <h3 class="mt-3 mb-0 text-site-intro font-semibold text-ink">{o.title}</h3>
              <div class={later ? "text-body font-semibold text-ink-muted" : "text-body font-semibold text-status-success-fg"}>{o.stage}</div>
            </li>
          );
        })
      }
    </ul>
    <ul class="m-0 mt-8 flex list-none flex-wrap gap-2 p-0 text-site-small">
      {d.chips.map((c) => <li class="rounded-pill border border-edge bg-surface px-4 py-2 text-ink">{c}</li>)}
      <li class="rounded-pill border border-dashed border-edge-strong bg-surface px-4 py-2 text-ink-muted">{d.placeholderChip}</li>
    </ul>
  </Container>
</section>
