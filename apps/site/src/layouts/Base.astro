---
import "../styles/site.css";
import fontSemibold from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url";
import fontRegular from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import { tokens } from "@agentvault/tokens";
import { copy } from "../content/en";

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Opt in to motion before first paint, unless the visitor prefers reduced motion.
      // If the motion script never starts (blocked, failed), drop motion so nothing stays hidden.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("motion");
        setTimeout(function () {
          if (!document.documentElement.hasAttribute("data-motion-ready")) document.documentElement.classList.remove("motion");
        }, 3000);
      }
    </script>
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content={tokens.color.light["bg-canvas"]} />
    <link rel="preload" href={fontSemibold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontRegular} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={copy.brand} />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.meta.ogAlt} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.meta.title} />
    <meta name="twitter:description" content={copy.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={copy.meta.ogAlt} />
  </head>
  <body class="bg-surface font-sans text-site-body text-ink" id="top">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-(--av-z-tooltip) focus:rounded-control focus:bg-surface focus:p-3 focus:text-link"
      >{copy.skip}</a
    >
    <slot />
    <script>
      import { initMotion } from "../scripts/motion";
      initMotion();
    </script>
  </body>
</html>
